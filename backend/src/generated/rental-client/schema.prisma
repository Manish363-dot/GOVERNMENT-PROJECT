// ============================================================================
// Database A: Rental Management Database Schema
// Zila Panchayat Almora — Commercial Asset & Rental Management System
// Completely isolated from Database B (SWM System)
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/rental-client"
}

datasource db {
  provider = "postgresql"
  url      = env("RENTAL_DATABASE_URL")
}

// ── Enumerations ────────────────────────────────────────────────────────────

enum RentalAdminRole {
  SUPER_ADMIN
  SUB_ADMIN
}

enum RentalAdminStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RentalUserStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PropertyType {
  COMMERCIAL_SHOP
  ROADSIDE_STALL
  WAREHOUSE_GODOWN
  LAND_PARCEL
  OFFICE_SPACE
  OTHER
}

enum PropertyStatus {
  VACANT
  ALLOTTED
  MAINTENANCE
  INACTIVE
}

enum BillStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  RECONCILED
}

enum LedgerEntryType {
  OPENING_BALANCE
  RENT_CHARGE
  PAYMENT
  ADJUSTMENT
  REFUND
  REVERSAL
}

enum DocumentType {
  AADHAAR
  PAN
  DOMICILE
  GST
  LEASE_AGREEMENT
  OTHER
}

enum DocVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum NoticeCategory {
  PUBLIC
  INDIVIDUAL
}

enum NoticePriority {
  NORMAL
  IMPORTANT
  URGENT
}

// ── 1. Rental Admin Model (Super Admin & Sub Admin) ─────────────────────────

model RentalAdmin {
  id            String            @id @default(uuid())
  username      String            @unique
  full_name     String
  mobile        String            @unique
  email         String?           @unique
  passwordHash  String
  role          RentalAdminRole   @default(SUB_ADMIN)
  status        RentalAdminStatus @default(ACTIVE)
  mfa_enabled   Boolean           @default(false)
  mfa_secret    String?
  permissions   String[]          @default([])
  last_login_at DateTime?
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt

  auditLogs RentalAdminAuditLog[]

  @@index([role, status])
  @@index([mobile])
}

// ── 2. Rental User Model (Registered Citizen / Tenant) ──────────────────────

model RentalUser {
  id                  String           @id @default(uuid())
  user_id             String           @unique // e.g. "ALM-RENT-2026-0001"
  full_name           String
  mobile              String           @unique
  email               String?
  passwordHash        String
  profile_photo_url   String?
  profile_photo_key   String?
  permanent_address   String
  current_address     String?
  aadhaar_masked      String? // e.g. "XXXX-XXXX-1234"
  pan_masked          String? // e.g. "XXXXX1234X"
  gst_number          String?
  status              RentalUserStatus @default(PENDING_VERIFICATION)
  deactivation_reason String?
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt

  documents          RentalUserDocument[]
  assignments        PropertyAssignment[]
  rentChangeHistory  RentChangeHistory[]
  bills              RentalBill[]
  payments           RentalPayment[]
  ledgerEntries      RentalLedgerEntry[]
  receipts           RentalReceipt[]
  notices            RentalNotice[]
  paymentAuditTrails PaymentAuditTrail[]

  @@index([status])
  @@index([mobile])
  @@index([user_id])
}

// ── 3. Rental User Documents Model (Private Identity Docs on S3) ────────────

model RentalUserDocument {
  id                  String                @id @default(uuid())
  user_id             String
  doc_type            DocumentType
  file_url            String // Private S3 object location
  s3_key              String // S3 key (e.g. rental/documents/...)
  file_name           String
  file_size           Int
  mime_type           String
  verification_status DocVerificationStatus @default(PENDING)
  verified_by         String? // Admin ID
  verification_remark String?
  verified_at         DateTime?
  created_at          DateTime              @default(now())

  user RentalUser @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, doc_type])
  @@index([verification_status])
}

// ── 4. Rental Property Model (Zila Panchayat Assets / Shops) ────────────────

model RentalProperty {
  id                String         @id @default(uuid())
  property_id       String         @unique // e.g. "SHOP-MKT-042"
  property_name     String
  property_type     PropertyType   @default(COMMERCIAL_SHOP)
  property_number   String
  location          String // e.g. "Mall Road Market, Almora"
  address           String
  dimensions_sqft   Float?
  base_monthly_rent Decimal        @db.Decimal(12, 2)
  status            PropertyStatus @default(VACANT)
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  assignments        PropertyAssignment[]
  rentChangeHistory  RentChangeHistory[]
  bills              RentalBill[]
  payments           RentalPayment[]
  ledgerEntries      RentalLedgerEntry[]
  receipts           RentalReceipt[]
  paymentAuditTrails PaymentAuditTrail[]

  @@index([property_id])
  @@index([status])
  @@index([location])
}

// ── 5. Property Assignment Model ────────────────────────────────────────────

model PropertyAssignment {
  id                  String    @id @default(uuid())
  property_id         String
  user_id             String
  monthly_rent        Decimal   @db.Decimal(12, 2)
  allotment_date      DateTime  @default(now())
  lease_start_date    DateTime
  lease_end_date      DateTime?
  is_active           Boolean   @default(true)
  deactivated_at      DateTime?
  deactivation_reason String?
  assigned_by         String // Admin ID
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  property RentalProperty @relation(fields: [property_id], references: [id], onDelete: Restrict)
  user     RentalUser     @relation(fields: [user_id], references: [id], onDelete: Restrict)
  bills    RentalBill[]

  @@index([property_id, is_active])
  @@index([user_id, is_active])
}

// ── 6. Rent Change History Model (Audit of all rent revisions) ──────────────

model RentChangeHistory {
  id             String   @id @default(uuid())
  user_id        String
  property_id    String
  previous_rent  Decimal  @db.Decimal(12, 2)
  new_rent       Decimal  @db.Decimal(12, 2)
  effective_date DateTime
  reason         String
  approved_by    String // Admin ID
  requested_by   String? // Optional Admin ID for maker-checker
  created_at     DateTime @default(now())

  user     RentalUser     @relation(fields: [user_id], references: [id], onDelete: Restrict)
  property RentalProperty @relation(fields: [property_id], references: [id], onDelete: Restrict)

  @@index([user_id, property_id])
  @@index([effective_date])
}

// ── 7. Monthly Rental Bill Model ────────────────────────────────────────────

model RentalBill {
  id                String     @id @default(uuid())
  bill_number       String     @unique // e.g. "BILL-2026-10-0042"
  user_id           String
  property_id       String
  assignment_id     String?
  billing_month     String // e.g. "2026-10"
  billing_year      Int
  rent_amount       Decimal    @db.Decimal(12, 2)
  adjustment_amount Decimal    @default(0.00) @db.Decimal(12, 2)
  total_amount_due  Decimal    @db.Decimal(12, 2)
  amount_paid       Decimal    @default(0.00) @db.Decimal(12, 2)
  balance_due       Decimal    @db.Decimal(12, 2)
  due_date          DateTime
  status            BillStatus @default(PENDING)
  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt

  user               RentalUser          @relation(fields: [user_id], references: [id], onDelete: Restrict)
  property           RentalProperty      @relation(fields: [property_id], references: [id], onDelete: Restrict)
  assignment         PropertyAssignment? @relation(fields: [assignment_id], references: [id], onDelete: SetNull)
  payments           RentalPayment[]
  ledgerEntries      RentalLedgerEntry[]
  receipts           RentalReceipt[]
  paymentAuditTrails PaymentAuditTrail[]

  @@unique([user_id, property_id, billing_month])
  @@index([status, due_date])
  @@index([user_id, status])
  @@index([billing_month])
}

// ── 8. Rental Payment Model (Gateway & Transaction Ledger) ──────────────────

model RentalPayment {
  id                 String        @id @default(uuid())
  payment_reference  String        @unique // Internal unique ref
  user_id            String
  property_id        String
  bill_id            String?
  amount             Decimal       @db.Decimal(12, 2)
  payment_method     String        @default("ONLINE") // UPI, CARD, NET_BANKING, NEFT, CASH
  gateway_order_id   String?       @unique
  gateway_payment_id String?
  gateway_signature  String?
  idempotency_key    String        @unique
  status             PaymentStatus @default(INITIATED)
  verified_at        DateTime?
  failure_reason     String?
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  user          RentalUser          @relation(fields: [user_id], references: [id], onDelete: Restrict)
  property      RentalProperty      @relation(fields: [property_id], references: [id], onDelete: Restrict)
  bill          RentalBill?         @relation(fields: [bill_id], references: [id], onDelete: SetNull)
  receipt       RentalReceipt?
  ledgerEntries RentalLedgerEntry[]
  auditTrails   PaymentAuditTrail[]

  @@index([user_id, status])
  @@index([gateway_order_id])
  @@index([created_at])
}

// ── 9. User Financial Ledger Model (Full audit of debits & credits) ─────────

model RentalLedgerEntry {
  id                    String          @id @default(uuid())
  user_id               String
  property_id           String
  bill_id               String?
  payment_id            String?
  entry_type            LedgerEntryType
  debit                 Decimal         @default(0.00) @db.Decimal(12, 2)
  credit                Decimal         @default(0.00) @db.Decimal(12, 2)
  running_balance       Decimal         @db.Decimal(12, 2)
  description           String
  transaction_reference String?
  created_at            DateTime        @default(now())

  user     RentalUser     @relation(fields: [user_id], references: [id], onDelete: Restrict)
  property RentalProperty @relation(fields: [property_id], references: [id], onDelete: Restrict)
  bill     RentalBill?    @relation(fields: [bill_id], references: [id], onDelete: SetNull)
  payment  RentalPayment? @relation(fields: [payment_id], references: [id], onDelete: SetNull)

  @@index([user_id, created_at])
  @@index([property_id, created_at])
}

// ── 10. Official Numbered Receipt Model ─────────────────────────────────────

model RentalReceipt {
  id              String   @id @default(uuid())
  receipt_number  String   @unique // e.g. "ZPA-REC-2026-0001"
  payment_id      String   @unique
  bill_id         String?
  user_id         String
  property_id     String
  amount_paid     Decimal  @db.Decimal(12, 2)
  billing_period  String
  receipt_pdf_url String? // S3 URL if generated
  issued_at       DateTime @default(now())

  payment  RentalPayment  @relation(fields: [payment_id], references: [id], onDelete: Restrict)
  bill     RentalBill?    @relation(fields: [bill_id], references: [id], onDelete: SetNull)
  user     RentalUser     @relation(fields: [user_id], references: [id], onDelete: Restrict)
  property RentalProperty @relation(fields: [property_id], references: [id], onDelete: Restrict)

  @@index([receipt_number])
  @@index([user_id, issued_at])
}

// ── 11. Append-Only Payment Audit Trail ─────────────────────────────────────

model PaymentAuditTrail {
  id               String   @id @default(uuid())
  payment_id       String?
  user_id          String
  property_id      String?
  bill_id          String?
  event_type       String // PAYMENT_INITIATED, WEBHOOK_RECEIVED, SUCCESS, DUPLICATE_BLOCKED, etc.
  previous_status  String?
  new_status       String?
  gateway_order_id String?
  gateway_txn_ref  String?
  actor_id         String?
  actor_type       String // CITIZEN, ADMIN, WEBHOOK, SYSTEM
  ip_address       String?
  user_agent       String?
  correlation_id   String?
  details          String? // Serialized JSON
  created_at       DateTime @default(now())

  payment  RentalPayment?  @relation(fields: [payment_id], references: [id], onDelete: SetNull)
  user     RentalUser      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  property RentalProperty? @relation(fields: [property_id], references: [id], onDelete: SetNull)
  bill     RentalBill?     @relation(fields: [bill_id], references: [id], onDelete: SetNull)

  @@index([user_id, created_at])
  @@index([payment_id])
  @@index([event_type])
}

// ── 12. Rental Notices Model (Public and Tenant Private Notices) ────────────

model RentalNotice {
  id                String         @id @default(uuid())
  notice_number     String         @unique
  title             String
  message           String
  category          NoticeCategory @default(PUBLIC)
  recipient_user_id String? // Null for public, tenant ID for private message
  attachment_url    String?
  priority          NoticePriority @default(NORMAL)
  is_published      Boolean        @default(true)
  published_at      DateTime       @default(now())
  expires_at        DateTime?
  created_by        String // Admin ID
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  recipient RentalUser? @relation(fields: [recipient_user_id], references: [id], onDelete: Cascade)

  @@index([category, is_published])
  @@index([recipient_user_id])
}

// ── 13. Administrative Action Audit Logs ────────────────────────────────────

model RentalAdminAuditLog {
  id            String   @id @default(uuid())
  admin_id      String
  action        String // USER_REGISTERED, RENT_CHANGED, PROPERTY_ASSIGNED, etc.
  target_entity String // RentalUser, RentalProperty, RentalBill
  target_id     String
  reason        String?
  before_state  String? // Serialized JSON
  after_state   String? // Serialized JSON
  ip_address    String?
  created_at    DateTime @default(now())

  admin RentalAdmin @relation(fields: [admin_id], references: [id], onDelete: Restrict)

  @@index([admin_id, created_at])
  @@index([target_entity, target_id])
}

// ── 14. Designated Officer Directory Model (User Profile Change Contacts) ───

model RentalDesignatedOfficer {
  id                   String   @id @default(uuid())
  full_name            String
  designation          String
  department           String
  office_phone         String
  official_email       String
  office_address       String
  working_hours        String
  contact_instructions String?
  is_active            Boolean  @default(true)
  updated_by           String?
  updated_at           DateTime @default(now())

  @@index([is_active])
}
